<Application x:Class="Ambaan.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="Text" Color="#F2F5F9"/>
        <SolidColorBrush x:Key="Muted" Color="#A3ADBD"/>
        <SolidColorBrush x:Key="Sky" Color="#4CC2FF"/>
        <SolidColorBrush x:Key="Lilac" Color="#A5B4FC"/>
        <SolidColorBrush x:Key="Green" Color="#5FD39A"/>
        <SolidColorBrush x:Key="Amber" Color="#F5C26B"/>
        <SolidColorBrush x:Key="Red" Color="#FF7B7B"/>
        <SolidColorBrush x:Key="CardBg" Color="#10FFFFFF"/>
        <SolidColorBrush x:Key="CardHover" Color="#1CFFFFFF"/>

        <!-- professional glass: graphite tint over a real blur, hairline light edge, faint top sheen -->
        <LinearGradientBrush x:Key="GlassFill" StartPoint="0,0" EndPoint="0.6,1">
            <GradientStop Color="#A6141922" Offset="0"/>
            <GradientStop Color="#B0161C27" Offset="0.6"/>
            <GradientStop Color="#BA19202D" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GlassFillSolid" StartPoint="0,0" EndPoint="0.6,1">
            <GradientStop Color="#F7141922" Offset="0"/>
            <GradientStop Color="#F7161C27" Offset="0.6"/>
            <GradientStop Color="#F819202D" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GlassEdge" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#5CFFFFFF" Offset="0"/>
            <GradientStop Color="#1CFFFFFF" Offset="0.25"/>
            <GradientStop Color="#0FFFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="Shine" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#16FFFFFF" Offset="0"/>
            <GradientStop Color="#00FFFFFF" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="GlassShell" TargetType="Border">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource GlassEdge}"/>
            <Setter Property="Background" Value="{StaticResource GlassFill}"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="#14FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,9"/>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="Pill" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="#1FFFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border CornerRadius="9" Background="{TemplateBinding Background}" BorderBrush="#24FFFFFF" BorderThickness="1"/>
                            <Border x:Name="hl" CornerRadius="9" Background="#00FFFFFF"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="hl" Property="Background" Value="#1AFFFFFF"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="hl" Property="Background" Value="#14000000"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="hl" CornerRadius="14" Background="#00FFFFFF"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="hl" Property="Background" Value="#24FFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Sky}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="9" Background="#00FFFFFF" Padding="8,2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#224CC2FF"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Background" Value="#0DFFFFFF"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Padding" Value="11,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1CFFFFFF"/></Trigger>
            </Style.Triggers>
        </Style>

        <!-- slim scrollbar for the glass panels -->
        <Style x:Key="SlimScroll" TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb"><Border CornerRadius="3" Background="#40FFFFFF"/></ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>

<Window x:Class="Ambaan.AlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ambaan alert" Width="290" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        FontFamily="Segoe UI" Foreground="{StaticResource Text}" UseLayoutRounding="True">
    <Grid x:Name="Root" RenderTransformOrigin="0.5,1">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="PopScale" ScaleX="1" ScaleY="1"/>
                <TranslateTransform x:Name="PopMove"/>
            </TransformGroup>
        </Grid.RenderTransform>
        <!-- card -->
        <Border x:Name="Card" Style="{StaticResource GlassShell}" Background="{StaticResource GlassFillSolid}" Margin="8,150,8,10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" Opacity="0.55" ShadowDepth="3" Color="Black"/>
            </Border.Effect>
            <Grid>
                <Border x:Name="Accent" Height="3" VerticalAlignment="Top" Margin="22,0,22,0" CornerRadius="2" Background="{StaticResource Red}"/>
                <Button x:Name="BtnClose" Style="{StaticResource IconBtn}" Content="&#xE8BB;" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"/>
                <StackPanel Margin="18,46,18,16">
                    <TextBlock x:Name="Title1" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock x:Name="Big" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="Line" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <TextBlock x:Name="Detail" FontSize="11.5" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <UniformGrid Columns="2" Margin="0,14,0,0">
                        <Button x:Name="Btn1" Style="{StaticResource Pill}" Margin="0,0,5,0"/>
                        <Button x:Name="Btn2" Style="{StaticResource Pill}" Margin="5,0,0,0"/>
                    </UniformGrid>
                </StackPanel>
            </Grid>
        </Border>
        <!-- the character stands on the card -->
        <Image x:Name="Character" Width="200" Height="190" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,0,0,0"
               RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5,1" IsHitTestVisible="False">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="CharScale"/>
                    <TranslateTransform x:Name="CharMove"/>
                </TransformGroup>
            </Image.RenderTransform>
        </Image>
    </Grid>
</Window>

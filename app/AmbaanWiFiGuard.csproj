<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>AmbaanWiFiGuard</AssemblyName>
    <RootNamespace>Ambaan</RootNamespace>
    <ApplicationIcon>Assets\ambaan.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>2.0.0</Version>
    <Product>Ambaan WiFi Guard</Product>
    <Company>Phoenicx</Company>
    <Copyright>Phoenicx - phoenicx.org</Copyright>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>CS0618;CS0649;CS0169;CS0414;CS1998;CS4014</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\*.*" LogicalName="assets/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Resources\report.html" LogicalName="report.html" />
    <EmbeddedResource Include="Resources\oui.txt.gz" LogicalName="oui.txt.gz" Condition="Exists('Resources\oui.txt.gz')" />
  </ItemGroup>
</Project>
